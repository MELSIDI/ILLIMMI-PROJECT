course "Conditionals & PEEL Essay Writing" id 6 idgap 100 for 130s audio "anglais_conditionals_argumentation.wav" {

    # ========================================================
    # SCÈNE 1 : Titre et vue d'ensemble (0s - 25s)
    # ========================================================
    text id 1 start 0.5s for 23s at (88.89, 12)
         ''[bold][color=#1E3A8A]English Writing Skills: Conditionals & Essay Mastery[/color][/bold]'' ;

    text id 2 start 4.5s for 19s at (88.89, 25)
         ''[italic]From grammar hypotheses to structured PEEL argumentative paragraphs[/italic]'' ;

    # ========================================================
    # SCÈNE 2 : Matrice des 3 Conditionnels (25s - 60s)
    # ========================================================
    erase id 401 start 25.0s ;

    text id 3 start 25.5s at (88.89, 12)
         ''[bold][color=#1E3A8A]The 3 Core Conditionals Compared[/color][/bold]'' ;

    # 1st Conditional
    draw polygone id 101 start 28.0s for 1.0s
         color (59, 130, 246, 0.8) fillcolor (239, 246, 255, 0.9) width 2
         at [(20, 24), (157.78, 24), (157.78, 42), (20, 42)] ;

    text id 4 start 30.0s at (88.89, 33)
         ''[bold][color=#1D4ED8]1st Conditional (Real Future) :[/color][/bold] If + Present $\longrightarrow$ will + verb'' ;

    # 2nd Conditional
    draw polygone id 102 start 40.0s for 1.0s
         color (16, 185, 129, 0.8) fillcolor (236, 253, 245, 0.9) width 2
         at [(20, 45), (157.78, 45), (157.78, 63), (20, 63)] ;

    text id 5 start 42.0s at (88.89, 54)
         ''[bold][color=#047857]2nd Conditional (Hypothetical Present) :[/color][/bold] If + Past Simple $\longrightarrow$ would + verb'' ;

    # 3rd Conditional
    draw polygone id 103 start 50.0s for 1.0s
         color (245, 158, 11, 0.8) fillcolor (254, 252, 232, 0.9) width 2
         at [(20, 66), (157.78, 66), (157.78, 84), (20, 84)] ;

    text id 6 start 52.0s at (88.89, 75)
         ''[bold][color=#B45309]3rd Conditional (Past Regret) :[/color][/bold] If + Past Perfect $\longrightarrow$ would have + past participle'' ;

    # ========================================================
    # SCÈNE 3 : La Méthode P.E.E.L. (60s - 95s)
    # ========================================================
    erase id 402 start 60.0s ;

    text id 7 start 60.5s at (88.89, 12)
         ''[bold][color=#1E3A8A]The P.E.E.L. Paragraph Architecture[/color][/bold]'' ;

    draw polygone id 104 start 65.0s for 1.0s
         color (99, 102, 241, 0.8) fillcolor (238, 242, 255, 0.9) width 2
         at [(25, 24), (55, 24), (55, 85), (25, 85)] ;

    text id 8 start 67.0s at (40, 32) ''[bold][color=#4338CA]P[/color][/bold]'' ;
    text id 9 start 72.0s at (40, 48) ''[bold][color=#4338CA]E[/color][/bold]'' ;
    text id 10 start 78.0s at (40, 64) ''[bold][color=#4338CA]E[/color][/bold]'' ;
    text id 11 start 85.0s at (40, 78) ''[bold][color=#4338CA]L[/color][/bold]'' ;

    text id 12 start 68.0s at (105, 32) ''[bold]Point :[/bold] Clear topic sentence stating the main argument'' ;
    text id 13 start 73.0s at (105, 48) ''[bold]Evidence :[/bold] Real-world data, case study or historical fact'' ;
    text id 14 start 79.0s at (105, 64) ''[bold]Explanation :[/bold] Deep analysis explaining why the evidence matters'' ;
    text id 15 start 86.0s at (105, 78) ''[bold]Link :[/bold] Logical bridge connecting back to the essay prompt'' ;

    # ========================================================
    # SCÈNE 4 : Piège classique 'Would in If' & Synthèse (95s - 130s)
    # ========================================================
    erase id 403 start 95.0s ;

    text id 16 start 95.5s at (88.89, 12)
         ''[bold][color=#DC2626]TOP EXAM MISTAKE TO AVOID AT ALL COSTS[/color][/bold]'' ;

    draw polygone id 105 start 98.0s for 1.0s
         color (239, 68, 68, 0.4) fillcolor (254, 242, 242, 0.9) width 2
         at [(25, 26), (152.78, 26), (152.78, 56), (25, 56)] ;

    text id 17 start 100.0s at (88.89, 36)
         ''[color=#DC2626]❌ NEVER put 'would' inside the IF clause ![/color]'' ;

    text id 18 start 104.0s at (88.89, 46)
         ''« If I would have known... » $\longrightarrow$ [bold][color=#10B981]« If I had known... »[/color][/bold]'' ;

    text id 19 start 115.0s at (88.89, 72)
         ''[bold][color=#1E3A8A]Golden Formula : Conditionals for nuance + PEEL for bulletproof logic[/color][/bold]'' ;
}
