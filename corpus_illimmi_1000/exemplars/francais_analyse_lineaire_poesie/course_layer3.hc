course "Explication Linéaire à l'Oral du Bac : Baudelaire" id 5 idgap 100 for 135s audio "francais_analyse_lineaire_poesie.wav" {

    # ========================================================
    # SCÈNE 1 : Titre et déroulé officiel de l'oral (0s - 25s)
    # ========================================================
    text id 1 start 0.5s for 23s at (88.89, 12)
         ''[bold][color=#1E3A8A]Oral du Bac de Français : L'Explication Linéaire[/color][/bold]'' ;

    text id 2 start 4.5s for 19s at (88.89, 25)
         ''[italic]Baudelaire — « L'Albatros », Les Fleurs du Mal (1857)[/italic]'' ;

    draw polygone id 101 start 8.0s for 1.5s
         color (100, 116, 139, 0.5) fillcolor (248, 250, 252, 0.9) width 2
         at [(25, 35), (152.78, 35), (152.78, 75), (25, 75)] ;

    text id 3 start 10.0s at (88.89, 45)
         ''[bold]Les 4 Étapes Clés face à l'Examinateur :[/bold]'' ;

    text id 4 start 14.0s at (88.89, 58)
         ''1. Lecture $\longrightarrow$ 2. Mouvements $\longrightarrow$ 3. Analyse mot à mot $\longrightarrow$ 4. Conclusion'' ;

    # ========================================================
    # SCÈNE 2 : Découpage structuré en trois mouvements (25s - 55s)
    # ========================================================
    erase id 401 start 25.0s ;

    text id 5 start 25.5s at (88.89, 12)
         ''[bold][color=#1E3A8A]Découpage en 3 Mouvements Pédagogiques[/color][/bold]'' ;

    # Boîte Mouvement 1
    draw polygone id 102 start 28.0s for 1.0s
         color (59, 130, 246, 0.8) fillcolor (239, 246, 255, 0.8) width 2
         at [(20, 25), (157.78, 25), (157.78, 42), (20, 42)] ;

    text id 6 start 30.0s at (88.89, 33)
         ''[bold][color=#1D4ED8]Mouvement 1 (Strophes 1-2) :[/color][/bold] La capture du roi des mers par l'équipage'' ;

    # Boîte Mouvement 2
    draw polygone id 103 start 38.0s for 1.0s
         color (245, 158, 11, 0.8) fillcolor (254, 252, 232, 0.8) width 2
         at [(20, 47), (157.78, 47), (157.78, 64), (20, 64)] ;

    text id 7 start 40.0s at (88.89, 55)
         ''[bold][color=#B45309]Mouvement 2 (Strophe 3) :[/color][/bold] La déchéance et le supplice du ridicule au sol'' ;

    # Boîte Mouvement 3
    draw polygone id 104 start 48.0s for 1.0s
         color (16, 185, 129, 0.8) fillcolor (236, 253, 245, 0.8) width 2
         at [(20, 69), (157.78, 69), (157.78, 86), (20, 86)] ;

    text id 8 start 50.0s at (88.89, 77)
         ''[bold][color=#047857]Mouvement 3 (Strophe 4) :[/color][/bold] L'allégorie explicite du Poète exilé dans la société'' ;

    # ========================================================
    # SCÈNE 3 : Méthode d'Or : Procédé + Citation + Effet (55s - 95s)
    # ========================================================
    erase id 402 start 55.0s ;

    text id 9 start 55.5s at (88.89, 12)
         ''[bold][color=#1E3A8A]La Formule d'Or : Procédé $\longrightarrow$ Citation $\longrightarrow$ Sens[/color][/bold]'' ;

    text id 10 start 60.0s at (45, 30)
         ''« Souvent, pour s'amuser, les hommes d'équipage... »'' ;

    # Antithèse rois de l'azur vs maladroits et honteux
    draw polygone id 105 start 66.0s for 1.0s
         color (220, 38, 38, 0.4) fillcolor (254, 242, 242, 0.8) width 2
         at [(25, 42), (152.78, 42), (152.78, 68), (25, 68)] ;

    text id 11 start 68.0s at (88.89, 48)
         ''[bold][color=#DC2626]Procédé : Antithèse saisissante[/color][/bold]'' ;

    text id 12 start 72.0s at (88.89, 58)
         ''[color=#1E3A8A]« Rois de l'azur »[/color] (Idéal céleste) $\quad \longleftrightarrow \quad$ [color=#DC2626]« Maladroits et honteux »[/color] (Spleen terrestre)'' ;

    text id 13 start 82.0s at (88.89, 78)
         ''[italic]Comparaison : Leurs ailes comme des avirons $\Longrightarrow$ L'instrument de majesté devient entrave.[/italic]'' ;

    # ========================================================
    # SCÈNE 4 : Piège de la paraphrase & Synthèse (95s - 135s)
    # ========================================================
    erase id 403 start 95.0s ;

    text id 14 start 95.5s at (88.89, 12)
         ''[bold][color=#DC2626]LE PIÈGE À ÉVITER : LA PARAPHRASE SANS ANALYSE[/color][/bold]'' ;

    text id 15 start 99.0s at (88.89, 32)
         ''[color=#DC2626]❌ Éviter : « Baudelaire raconte que les marins attrapent un oiseau... »[/color]'' ;

    text id 16 start 106.0s at (88.89, 48)
         ''[bold][color=#10B981]✅ Exiger : « À travers la métaphore filée, le poète stylise sa propre exclusion... »[/color][/bold]'' ;

    draw polygone id 106 start 115.0s for 1.0s
         color (59, 130, 246, 0.5) fillcolor (239, 246, 255, 0.9) width 2
         at [(25, 62), (152.78, 62), (152.78, 88), (25, 88)] ;

    text id 17 start 118.0s at (88.89, 75)
         ''[bold][color=#1E3A8A]Règle d'or de l'oral : Toujours justifier l'interprétation par un procédé formel ![/color][/bold]'' ;
}
