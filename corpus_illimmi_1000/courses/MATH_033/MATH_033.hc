    # SCENE 12 : Fonction racine carrée
    text id 140 start 1570.50s for 2.20s at (4.00, 5.50) ''[bold][color=#34D399]10. RÉFÉRENCE 4 : FONCTION RACINE CARRÉE[/color][/bold]'' ;
    draw line id 1104 start 1572.95s color (56, 189, 248, 0.95) width 1.6 at [(4.00, 11.50), (173.00, 11.50)] ;
