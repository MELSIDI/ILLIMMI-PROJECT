    # SCENE 9 : Fonctions affines
    text id 110 start 1287.10s for 2.20s at (4.00, 5.50) ''[bold][color=#38BDF8]7. RÉFÉRENCE 1 : FONCTIONS AFFINES[/color][/bold]'' ;
    draw line id 1080 start 1289.55s color (56, 189, 248, 0.95) width 1.6 at [(4.00, 11.50), (173.00, 11.50)] ;
    text id 111 start 1302.90s for 2.40s at (4.00, 16.00) ''[bold][color=#F8FAFC]Expression : $f(x) = ax + b$[/color][/bold]'' ;
    text id 112 start 1316.00s for 2.80s at (4.00, 24.00) ''[color=#94A3B8]• Si $b = 0$ : linéaire $f(x) = ax$[/color]'' ;
    text id 113 start 1344.50s for 2.50s at (4.00, 33.00) ''[bold][color=#FBBF24]Sens de variation selon le signe de $a$ :[/color][/bold]'' ;
    draw 2drep id 1081 start 1353.00s for 1.80s at (132.00, 56.00) x_range = [-4, 4] y_range = [-4, 4] scale = 6.50 grid = true grid_alpha = 0.7 step = 1.0 labels = true color (148, 163, 184, 0.95) width 1.6 ;
    draw 2dfunc id 1082 start 1357.50s for 2.00s color (52, 211, 153, 0.95) width 3.0 at 1081 y = 0.8*x + 0.5 ;
    text id 114 start 1360.00s for 2.20s at (6.00, 42.00) ''[bold][color=#34D399]• $a > 0$ : droite qui monte[/color][/bold]'' ;
    text id 115 start 1363.00s at (8.00, 49.50) ''[color=#34D399]$\implies f$ strictement croissante sur $\mathbb{R}$[/color]'' ;
    draw 2dfunc id 1083 start 1368.80s for 2.00s color (248, 113, 113, 0.95) width 3.0 at 1081 y = -0.8*x + 0.5 ;
    text id 116 start 1371.50s for 2.20s at (6.00, 58.00) ''[bold][color=#F87171]• $a < 0$ : droite qui descend[/color][/bold]'' ;
    text id 117 start 1374.50s at (8.00, 65.50) ''[color=#F87171]$\implies f$ strictement décroissante sur $\mathbb{R}$[/color]'' ;
    draw 2dfunc id 1084 start 1377.50s for 2.00s color (251, 191, 36, 0.95) width 3.0 at 1081 y = 2 ;
    text id 118 start 1380.50s for 2.20s at (6.00, 74.00) ''[bold][color=#FBBF24]• $a = 0$ : droite horizontale[/color][/bold]'' ;
    text id 119 start 1384.00s at (8.00, 81.50) ''[color=#FBBF24]$\implies f$ constante ($f(x) = b$ sur $\mathbb{R}$)[/color]'' ;
    erase id 4009 start 1394.60s ;

    # SCENE 10 : Fonction carré
    text id 120 start 1395.00s for 2.20s at (4.00, 5.50) ''[bold][color=#38BDF8]8. RÉFÉRENCE 2 : FONCTION CARRÉ[/color][/bold]'' ;
    draw line id 1085 start 1397.45s color (56, 189, 248, 0.95) width 1.6 at [(4.00, 11.50), (173.00, 11.50)] ;
    text id 121 start 1399.00s for 2.20s at (4.00, 16.50) ''[bold][color=#F8FAFC]Définition : $f(x) = x^2$ sur $\mathbb{R}$[/color][/bold]'' ;
    draw 2drep id 1086 start 1402.00s for 1.80s at (132.00, 80.00) x_range = [-3, 3] y_range = [-1, 9] scale = 5.40 grid = true grid_alpha = 0.7 step = 1.0 labels = true color (148, 163, 184, 0.95) width 1.6 ;
    draw 2dfunc id 1087 start 1404.50s for 2.20s color (56, 189, 248, 0.95) width 3.2 at 1086 y = x^2 ;
    text id 122 start 1407.50s for 2.40s at (4.00, 26.00) ''[color=#38BDF8]Courbe : parabole tournée vers le haut[/color]'' ;
    text id 123 start 1421.30s for 1.80s at (4.00, 36.50) ''[bold][color=#FBBF24]Variations sur $\mathbb{R}$ :[/color][/bold]'' ;
    text id 124 start 1426.00s for 2.40s at (6.00, 44.50) ''[color=#F87171]$\bullet$ Décroissante sur $]-\infty ; 0]$[/color]'' ;
    text id 125 start 1432.00s for 2.40s at (6.00, 52.50) ''[color=#34D399]$\bullet$ Croissante sur $[0 ; +\infty[$[/color]'' ;
    draw circle id 1088 start 1438.50s color (251, 191, 36, 0.95) width 2.8 radius 0.90 at (132.00, 80.00) ;
    text id 126 start 1439.50s for 2.20s at (4.00, 62.50) ''[bold][color=#FBBF24]Minimum égal à $0$, atteint en $x = 0$.[/color][/bold]'' ;
    erase id 4010 start 1442.40s ;

