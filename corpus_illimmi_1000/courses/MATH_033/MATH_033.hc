    draw 2drep id 1105 start 1578.00s for 1.80s at (104.00, 74.00) x_range = [-1, 8] y_range = [-1, 5] scale = 6.00 grid = true grid_alpha = 0.7 step = 1.0 labels = true color (148, 163, 184, 0.95) width 1.6 ;
