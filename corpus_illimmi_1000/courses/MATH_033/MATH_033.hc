    draw circle id 1094 start 1467.00s color (248, 113, 113, 0.95) width 2.6 radius 0.85 at (132.00, 42.00) ;
    text id 130 start 1470.00s for 2.60s at (4.00, 36.00) ''[color=#F87171]Valeur interdite : $x = 0$ (division par $0$ impossible)[/color]'' ;
