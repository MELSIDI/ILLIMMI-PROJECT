    text id 131 start 1500.00s at (100.00, 70.50) ''[bold][color=#38BDF8]$x$[/color][/bold]'' ;
    text id 132 start 1501.00s at (97.50, 82.00) ''[bold][color=#C084FC]$1/x$[/color][/bold]'' ;
    text id 133 start 1502.00s at (110.00, 70.50) ''[color=#F8FAFC]$-\infty$[/color]'' ;
    text id 134 start 1503.00s at (136.50, 70.50) ''[bold][color=#F87171]$0$[/color][/bold]'' ;
