    # SCENE 13 : Fonction cube & stricte monotonie
    text id 147 start 1627.70s for 2.20s at (4.00, 5.50) ''[bold][color=#38BDF8]11. FONCTION CUBE ET STRICTE MONOTONIE[/color][/bold]'' ;
    draw line id 1110 start 1630.15s color (56, 189, 248, 0.95) width 1.6 at [(4.00, 11.50), (173.00, 11.50)] ;
    text id 148 start 1631.80s for 2.20s at (4.00, 16.00) ''[bold][color=#F8FAFC]Définition : $f(x) = x^3$ sur $\mathbb{R}$[/color][/bold]'' ;
    draw 2drep id 1111 start 1635.00s for 1.80s at (132.00, 39.00) x_range = [-3, 3] y_range = [-5, 5] scale = 4.50 grid = true grid_alpha = 0.7 step = 1.0 labels = true color (148, 163, 184, 0.95) width 1.6 ;
    draw curve id 1112 start 1637.50s for 2.40s smooth color (56, 189, 248, 0.95) width 3.2 at [(124.35, 61.11), (125.25, 54.19), (126.38, 47.79), (127.50, 43.50), (128.85, 40.54), (130.20, 39.29), (132.00, 39.00), (133.80, 38.71), (135.15, 37.46), (136.50, 34.50), (137.62, 30.21), (138.75, 23.81), (139.65, 16.89)] ;
    text id 149 start 1644.50s for 2.20s at (4.00, 25.00) ''[bold][color=#34D399]Strictement croissante sur $\mathbb{R}$ :[/color][/bold]'' ;
    text id 150 start 1649.00s for 2.20s at (6.00, 32.50) ''[color=#38BDF8]$$a < b \implies a^3 < b^3$$[/color]'' ;
    text id 151 start 1666.00s for 2.40s at (4.00, 44.00) ''[bold][color=#FBBF24]Croissante vs Strictement croissante :[/color][/bold]'' ;
    text id 152 start 1670.50s for 2.80s at (6.00, 52.00) ''[color=#F8FAFC]$\bullet$ Croissante : palier plat autorisé ($f(a) \le f(b)$)[/color]'' ;
    draw polygone id 1113 start 1674.00s for 1.40s color (251, 191, 36, 0.95) fillcolor (251, 191, 36, 0.14) width 1.8 at [(98.00, 67.00), (166.00, 67.00), (166.00, 92.00), (98.00, 92.00)] ;
