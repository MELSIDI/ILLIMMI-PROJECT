    text id 142 start 1584.00s for 2.40s at (4.00, 26.00) ''[color=#34D399]Courbe : demi-parabole partant de $O(0 ; 0)$[/color]'' ;
    text id 143 start 1593.00s for 2.80s at (4.00, 35.50) ''[color=#F87171]Jamais de négatif sous $\sqrt{\phantom{x}}$ (ex : $\sqrt{-5}$ impossible)[/color]'' ;
