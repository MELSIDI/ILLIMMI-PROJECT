    text id 137 start 1525.00s for 2.80s at (4.00, 54.00) ''[bold][color=#F8FAFC]Décroissante sur $]-\infty ; 0[$ ET sur $]0 ; +\infty[$[/color][/bold]'' ;
    text id 138 start 1535.00s for 2.60s at (4.00, 63.50) ''[bold][color=#FBBF24]PIÈGE CLASSIQUE : JAMAIS d'union ($\cup$) ![/color][/bold]'' ;
