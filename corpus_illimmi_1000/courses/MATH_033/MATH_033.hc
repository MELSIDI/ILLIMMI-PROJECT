course "MATH_033 : Variations de fonctions et extrema" id 1 idgap 1000 for 1737.75s audio "narration.wav" {

    # SCENE 1 : Programme du cours
    text id 1 start 0.20s for 2.20s at (4.00, 5.50) ''[bold][color=#38BDF8]VARIATIONS ET EXTREMA D'UNE FONCTION[/color][/bold]'' ;
    draw line id 1001 start 2.65s color (56, 189, 248, 0.95) width 1.6 at [(4.00, 11.50), (173.00, 11.50)] ;
    text id 2 start 7.00s for 2.20s at (4.00, 15.50) ''[bold][color=#FBBF24]Programme de la séance :[/color][/bold]'' ;
    text id 3 start 13.80s for 1.40s at (4.00, 23.50) ''[bold][color=#34D399]1. Sens de variation :[/color][/bold]'' ;
    text id 4 start 15.60s for 3.50s at (6.00, 30.00) ''[color=#F8FAFC]Croissante, décroissante, constante, monotone[/color]'' ;
    draw polygone id 1002 start 19.50s for 1.40s color (52, 211, 153, 0.95) fillcolor (52, 211, 153, 0.14) width 2.0 at [(95.00, 18.00), (131.00, 18.00), (131.00, 50.00), (95.00, 50.00)] ;
    text id 5 start 21.20s at (98.00, 20.50) ''[bold][color=#34D399]Sens de variation[/color][/bold]'' ;
    draw curve id 1003 start 21.60s for 1.50s smooth color (52, 211, 153, 0.95) width 2.8 at [(99.00, 44.00), (108.00, 41.00), (117.00, 32.00), (126.00, 26.00)] with arrow at end ;
    text id 6 start 23.80s for 1.80s at (4.00, 39.00) ''[bold][color=#38BDF8]2. Extrema d'une fonction :[/color][/bold]'' ;
    text id 7 start 26.20s for 3.50s at (6.00, 45.50) ''[color=#F8FAFC]Minimum et maximum (absolu ou relatif)[/color]'' ;
    draw polygone id 1004 start 30.00s for 1.40s color (56, 189, 248, 0.95) fillcolor (56, 189, 248, 0.14) width 2.0 at [(135.00, 18.00), (171.00, 18.00), (171.00, 50.00), (135.00, 50.00)] ;
    text id 8 start 31.80s at (138.00, 20.50) ''[bold][color=#38BDF8]Minimum / Maximum[/color][/bold]'' ;
    draw curve id 1005 start 32.20s for 1.50s smooth color (56, 189, 248, 0.95) width 2.8 at [(139.00, 44.00), (146.00, 28.00), (154.00, 30.00), (161.00, 43.00), (168.00, 35.00)] ;
    text id 9 start 34.30s for 1.80s at (4.00, 54.50) ''[bold][color=#FBBF24]3. Tableau de variations :[/color][/bold]'' ;
    text id 10 start 36.40s for 2.20s at (6.00, 61.00) ''[color=#F8FAFC]Construire le tableau à partir d'une courbe[/color]'' ;
    draw polygone id 1006 start 39.00s color (251, 191, 36, 0.95) fillcolor (251, 191, 36, 0.14) width 2.0 at [(95.00, 55.00), (131.00, 55.00), (131.00, 87.00), (95.00, 87.00)] ;
    text id 11 start 39.40s at (97.50, 57.50) ''[bold][color=#FBBF24]Tableau de variations[/color][/bold]'' ;
    draw arrow id 1007 start 39.80s color (251, 191, 36, 0.95) width 2.4 at [(102.00, 81.00), (112.00, 69.00)] ;
    draw arrow id 1008 start 40.10s color (251, 191, 36, 0.95) width 2.4 at [(115.00, 69.00), (125.00, 81.00)] ;
    text id 12 start 40.80s for 1.40s at (4.00, 70.00) ''[bold][color=#C084FC]4. Cinq fonctions de référence :[/color][/bold]'' ;
    text id 13 start 42.50s for 3.20s at (6.00, 76.50) ''[color=#F8FAFC]Affines, carré, inverse, racine carrée, cube[/color]'' ;
    draw polygone id 1009 start 46.00s for 1.40s color (192, 132, 252, 0.95) fillcolor (192, 132, 252, 0.14) width 2.0 at [(135.00, 55.00), (171.00, 55.00), (171.00, 87.00), (135.00, 87.00)] ;
    text id 14 start 47.80s at (140.00, 57.50) ''[bold][color=#C084FC]5 Références[/color][/bold]'' ;
    draw curve id 1010 start 48.20s for 1.40s smooth color (192, 132, 252, 0.95) width 2.5 at [(140.00, 66.00), (147.00, 81.00), (154.00, 66.00)] ;
    draw curve id 1011 start 50.00s for 1.40s smooth color (248, 113, 113, 0.95) width 2.5 at [(158.00, 82.00), (161.00, 74.00), (168.00, 69.00)] ;
    mouse move id 3001 start 54.00s for 2.50s at [(113.00, 34.00), (153.00, 34.00), (113.00, 71.00), (153.00, 72.00)] ;
    erase id 4001 start 62.50s ;

    # SCENE 2 : Sens de variation - lecture gauche -> droite
    text id 15 start 62.80s for 2.20s at (4.00, 5.50) ''[bold][color=#38BDF8]1. FONCTION CROISSANTE : LECTURE INTUITIVE[/color][/bold]'' ;
    draw line id 1012 start 65.25s color (56, 189, 248, 0.95) width 1.6 at [(4.00, 11.50), (173.00, 11.50)] ;
    draw 2drep id 1013 start 71.50s for 2.20s at (106.00, 76.00) x_range = [-1, 6] y_range = [-1, 5] scale = 7.50 grid = true grid_alpha = 0.7 step = 1.0 labels = true color (148, 163, 184, 0.95) width 1.6 ;
    draw 2dfunc id 1014 start 74.20s for 2.80s color (52, 211, 153, 0.95) width 3.2 at 1013 y = 0.1*x^2 + 0.25*x + 0.5 ;
    text id 16 start 78.00s for 2.40s at (4.00, 17.00) ''[bold][color=#FBBF24]De la gauche vers la droite :[/color][/bold]'' ;
    text id 17 start 81.50s for 2.50s at (4.00, 25.00) ''[color=#F8FAFC]$\bullet$ Les abscisses $x$ augmentent.[/color]'' ;
    text id 18 start 88.00s for 2.80s at (4.00, 33.00) ''[color=#34D399]$\bullet$ Ici, la courbe monte sans cesse.[/color]'' ;
    draw circle id 1015 start 103.50s color (251, 191, 36, 0.95) width 2.8 radius 0.90 at (107.50, 71.84) ;
    mouse move id 3002 start 105.00s for 4.50s at [(107.50, 71.84), (124.75, 62.88), (142.00, 45.97)] ;
    draw circle id 1016 start 110.00s color (251, 191, 36, 0.95) width 2.8 radius 0.90 at (142.00, 45.97) ;
    text id 19 start 124.50s for 1.80s at (4.00, 44.00) ''[bold][color=#F87171]Piège fréquent :[/color][/bold]'' ;
    text id 20 start 127.00s for 2.80s at (4.00, 51.50) ''[color=#F87171]Ne JAMAIS lire de droite à gauche ![/color]'' ;
    draw arrow id 1017 start 155.50s for 2.20s color (251, 191, 36, 0.95) width 3.0 at [(106.00, 80.88), (145.00, 80.88)] ;
    text id 21 start 158.20s for 2.00s at (110.00, 83.38) ''[color=#FBBF24]Sens de lecture ($x$ croissants)[/color]'' ;
    text id 22 start 165.40s for 1.60s at (4.00, 63.00) ''[bold][color=#34D399]Règle d'or :[/color][/bold]'' ;
    text id 23 start 168.00s for 2.80s at (4.00, 70.50) ''[color=#F8FAFC]De gauche à droite, si la courbe monte :[/color]'' ;
    text id 24 start 174.50s for 2.50s at (6.00, 78.50) ''[bold][color=#34D399]$\Rightarrow f$ est croissante.[/color][/bold]'' ;
    erase id 4002 start 183.50s ;

    # SCENE 3 : Définition fonction croissante & ex a=1, b=2
    text id 25 start 184.00s for 2.20s at (4.00, 5.50) ''[bold][color=#38BDF8]DÉFINITION FORMELLE : FONCTION CROISSANTE[/color][/bold]'' ;
    draw line id 1018 start 186.45s color (56, 189, 248, 0.95) width 1.6 at [(4.00, 11.50), (173.00, 11.50)] ;
    draw 2drep id 1019 start 187.50s for 2.00s at (108.00, 76.00) x_range = [-1, 5] y_range = [-1, 5] scale = 8.50 grid = true grid_alpha = 0.7 step = 1.0 labels = true color (148, 163, 184, 0.95) width 1.6 ;
    draw 2dfunc id 1020 start 190.00s for 2.40s color (52, 211, 153, 0.95) width 3.2 at 1019 y = 0.35*x^2 + 0.4 ;
    text id 26 start 194.80s for 2.60s at (4.00, 13.50) ''[color=#F8FAFC]$f$ est croissante sur un intervalle $I$ si :[/color]'' ;
    text id 27 start 199.00s for 2.20s at (4.00, 20.00) ''[color=#94A3B8]Pour tous réels $a, b \in I$ :[/color]'' ;
    text id 28 start 203.20s for 3.20s at (6.00, 26.50) ''[bold][color=#34D399]$a < b \implies f(a) < f(b)$[/color][/bold]'' ;
    text id 29 start 216.50s for 2.80s at (6.00, 34.00) ''[color=#FBBF24](ou $a \le b \implies f(a) \le f(b)$)[/color]'' ;
    text id 30 start 221.00s for 2.80s at (4.00, 40.50) ''[bold][color=#38BDF8]Une fonction croissante conserve l'ordre ![/color][/bold]'' ;
    text id 31 start 229.00s for 1.60s at (4.00, 47.00) ''[bold][color=#FBBF24]Exemple sur le repère :[/color][/bold]'' ;
    text id 32 start 231.20s for 2.60s at (6.00, 53.50) ''[color=#F8FAFC]$a = 1$ et $b = 2$ (donc $a < b$)[/color]'' ;
    draw circle id 1021 start 236.00s color (251, 191, 36, 0.95) width 2.4 radius 0.70 at (116.50, 76.00) ;
    text id 33 start 237.00s at (6.00, 61.00) ''[color=#FBBF24]• $a = 1$ placé sur l'axe $(Ox)$[/color]'' ;
    draw circle id 1022 start 240.00s color (192, 132, 252, 0.95) width 2.4 radius 0.70 at (125.00, 76.00) ;
    text id 34 start 241.00s at (6.00, 67.50) ''[color=#C084FC]• $b = 2$ placé à droite de $a$[/color]'' ;
    draw line id 1023 start 264.00s for 1.60s color (251, 191, 36, 0.95) width 1.8 at [(116.50, 76.00), (116.50, 69.62)] ;
    draw circle id 1024 start 266.20s color (251, 191, 36, 0.95) width 2.6 radius 0.80 at (116.50, 69.62) ;
    draw line id 1025 start 267.50s for 1.60s color (251, 191, 36, 0.95) width 1.8 at [(116.50, 69.62), (108.00, 69.62)] ;
    text id 35 start 270.00s at (6.00, 74.00) ''[bold][color=#FBBF24]• Image $f(a)$ sur l'axe $(Oy)$[/color][/bold]'' ;
    draw line id 1026 start 281.20s for 1.60s color (192, 132, 252, 0.95) width 1.8 at [(125.00, 76.00), (125.00, 60.70)] ;
    draw circle id 1027 start 283.50s color (192, 132, 252, 0.95) width 2.6 radius 0.80 at (125.00, 60.70) ;
    draw line id 1028 start 288.70s for 1.60s color (192, 132, 252, 0.95) width 1.8 at [(125.00, 60.70), (108.00, 60.70)] ;
    text id 36 start 291.00s at (6.00, 80.50) ''[bold][color=#C084FC]• Image $f(b)$ sur l'axe $(Oy)$[/color][/bold]'' ;
    draw arrow id 1029 start 298.50s for 1.50s color (52, 211, 153, 0.95) width 2.4 at [(106.00, 69.62), (106.00, 60.70)] ;
    text id 37 start 312.70s for 2.60s at (6.00, 87.00) ''[color=#F8FAFC]On lit : $f(a)$ est sous $f(b)$[/color]'' ;
    text id 38 start 320.00s for 2.80s at (6.00, 93.50) ''[bold][color=#34D399]$\Rightarrow f(1) < f(2)$ : ordre conservé ![/color][/bold]'' ;
    erase id 4003 start 337.90s ;

    # SCENE 4 : Fonction décroissante & ex a=1, b=3
    text id 39 start 338.30s for 2.20s at (4.00, 5.50) ''[bold][color=#F87171]2. FONCTION DÉCROISSANTE SUR UN INTERVALLE[/color][/bold]'' ;
    draw line id 1030 start 340.75s color (56, 189, 248, 0.95) width 1.6 at [(4.00, 11.50), (173.00, 11.50)] ;
    draw 2drep id 1031 start 341.20s for 2.00s at (108.00, 76.00) x_range = [-1, 5] y_range = [-1, 5] scale = 8.50 grid = true grid_alpha = 0.7 step = 1.0 labels = true color (148, 163, 184, 0.95) width 1.6 ;
    draw 2dfunc id 1032 start 343.60s for 2.60s color (248, 113, 113, 0.95) width 3.2 at 1031 y = 4.5 - 0.18*x^2 - 0.4*x ;
    draw circle id 1033 start 354.50s color (251, 191, 36, 0.95) width 2.6 radius 0.85 at (112.25, 39.83) ;
    mouse move id 3003 start 356.00s for 4.50s at [(112.25, 39.83), (125.00, 50.67), (138.60, 69.82)] ;
    draw circle id 1034 start 361.00s color (251, 191, 36, 0.95) width 2.6 radius 0.85 at (138.60, 69.82) ;
    text id 40 start 364.00s for 2.60s at (4.00, 13.50) ''[color=#F8FAFC]De gauche à droite, la courbe descend :[/color]'' ;
    text id 41 start 383.00s for 1.80s at (4.00, 20.00) ''[bold][color=#38BDF8]Définition formelle :[/color][/bold]'' ;
    text id 42 start 386.00s for 2.80s at (4.00, 26.50) ''[color=#F8FAFC]$f$ est décroissante sur $I$ si $\forall a, b \in I$ :[/color]'' ;
    text id 43 start 394.00s for 3.00s at (6.00, 33.00) ''[bold][color=#F87171]$a < b \implies f(a) > f(b)$[/color][/bold]'' ;
    text id 44 start 406.50s for 3.00s at (6.00, 40.50) ''[color=#FBBF24](et $a \le b \implies f(a) \ge f(b)$ : sens inversé !)[/color]'' ;
    text id 45 start 420.50s for 2.40s at (4.00, 47.00) ''[bold][color=#F8FAFC]Exemple : $a = 1$ et $b = 3$ ($a < b$)[/color][/bold]'' ;
    draw circle id 1035 start 424.00s color (251, 191, 36, 0.95) width 2.4 radius 0.70 at (116.50, 76.00) ;
    text id 46 start 425.00s at (6.00, 54.50) ''[color=#FBBF24]• $a = 1$ placé sur l'axe $(Ox)$[/color]'' ;
    draw circle id 1036 start 428.00s color (192, 132, 252, 0.95) width 2.4 radius 0.70 at (133.50, 76.00) ;
    text id 47 start 429.00s at (6.00, 61.00) ''[color=#C084FC]• $b = 3$ placé à droite de $a$[/color]'' ;
    draw line id 1037 start 435.70s for 1.60s color (251, 191, 36, 0.95) width 1.8 at [(116.50, 76.00), (116.50, 42.68)] ;
    draw circle id 1038 start 437.80s color (251, 191, 36, 0.95) width 2.6 radius 0.80 at (116.50, 42.68) ;
    draw line id 1039 start 439.00s for 1.60s color (251, 191, 36, 0.95) width 1.8 at [(116.50, 42.68), (108.00, 42.68)] ;
    text id 48 start 441.50s at (6.00, 67.50) ''[bold][color=#FBBF24]• Image $f(a)$ en haut sur $(Oy)$[/color][/bold]'' ;
    draw line id 1040 start 443.70s for 1.60s color (192, 132, 252, 0.95) width 1.8 at [(133.50, 76.00), (133.50, 61.72)] ;
    draw circle id 1041 start 445.80s color (192, 132, 252, 0.95) width 2.6 radius 0.80 at (133.50, 61.72) ;
    draw line id 1042 start 447.00s for 1.60s color (192, 132, 252, 0.95) width 1.8 at [(133.50, 61.72), (108.00, 61.72)] ;
    text id 49 start 449.50s at (6.00, 74.00) ''[bold][color=#C084FC]• Image $f(b)$ plus bas sur $(Oy)$[/color][/bold]'' ;
    draw arrow id 1043 start 457.00s for 1.50s color (248, 113, 113, 0.95) width 2.4 at [(106.00, 42.68), (106.00, 61.72)] ;
    text id 50 start 461.00s for 2.50s at (6.00, 80.50) ''[color=#F8FAFC]On lit : $f(a)$ est au-dessus de $f(b)$[/color]'' ;
    text id 51 start 466.00s for 2.50s at (6.00, 87.00) ''[bold][color=#F87171]$\Rightarrow a < b$ mais $f(a) > f(b)$[/color][/bold]'' ;
    text id 52 start 473.00s for 2.50s at (4.00, 94.00) ''[color=#38BDF8]L'inégalité change de sens ![/color]'' ;
    erase id 4004 start 494.10s ;

    # SCENE 5 : Fonction constante, monotone & bilan
    text id 53 start 494.60s for 2.20s at (4.00, 5.50) ''[bold][color=#FBBF24]3. FONCTION CONSTANTE ET MONOTONE[/color][/bold]'' ;
    draw line id 1044 start 497.05s color (56, 189, 248, 0.95) width 1.6 at [(4.00, 11.50), (173.00, 11.50)] ;
    text id 54 start 498.50s for 2.20s at (4.00, 14.50) ''[bold][color=#FBBF24]Fonction constante sur $I$ :[/color][/bold]'' ;
    text id 55 start 506.80s for 2.60s at (6.00, 21.00) ''[color=#F8FAFC]$$\forall a, b \in I,\quad f(a) = f(b) = k$$[/color]'' ;
    draw 2drep id 1045 start 519.00s for 1.80s at (108.00, 76.00) x_range = [-1, 5] y_range = [-1, 5] scale = 8.00 grid = true grid_alpha = 0.7 step = 1.0 labels = true color (148, 163, 184, 0.95) width 1.6 ;
    draw 2dfunc id 1046 start 521.20s for 2.20s color (251, 191, 36, 0.95) width 3.2 at 1045 y = 2.5 ;
    draw line id 1047 start 530.50s for 1.40s color (56, 189, 248, 0.95) width 1.8 at [(116.00, 76.00), (116.00, 56.00)] ;
    draw line id 1048 start 532.50s for 1.40s color (56, 189, 248, 0.95) width 1.8 at [(136.00, 76.00), (136.00, 56.00)] ;
    text id 56 start 534.50s at (6.00, 31.50) ''[color=#38BDF8]• Abscisse $a$ quelconque sur $(Ox)$[/color]'' ;
    text id 57 start 536.00s at (6.00, 38.00) ''[color=#38BDF8]• Abscisse $b$ quelconque sur $(Ox)$[/color]'' ;
    text id 58 start 537.50s at (6.00, 44.50) ''[bold][color=#FBBF24]• Même ordonnée : $f(a) = f(b) = k$[/color][/bold]'' ;
    text id 59 start 539.50s for 2.20s at (6.00, 51.00) ''[color=#94A3B8]Graphiquement : droite horizontale.[/color]'' ;
    text id 60 start 547.00s for 2.20s at (4.00, 57.50) ''[bold][color=#38BDF8]Fonction monotone sur $I$ :[/color][/bold]'' ;
    text id 61 start 552.00s for 2.80s at (6.00, 64.00) ''[color=#F8FAFC]Soit croissante sur $I$, soit décroissante sur $I$.[/color]'' ;
    text id 62 start 563.80s for 2.00s at (4.00, 71.00) ''[bold][color=#34D399]À retenir absolument :[/color][/bold]'' ;
    text id 63 start 567.50s for 2.80s at (6.00, 77.50) ''[color=#34D399]• Croissante : ordre CONSERVÉ[/color]'' ;
    text id 64 start 578.00s for 2.80s at (6.00, 84.00) ''[color=#F87171]• Décroissante : ordre INVERSÉ[/color]'' ;
    erase id 4005 start 595.60s ;

    # SCENE 6 : Extrema - Maximum
    text id 65 start 596.00s for 2.20s at (4.00, 5.50) ''[bold][color=#38BDF8]4. EXTREMA : MAXIMUM D'UNE FONCTION[/color][/bold]'' ;
    draw line id 1049 start 598.45s color (56, 189, 248, 0.95) width 1.6 at [(4.00, 11.50), (173.00, 11.50)] ;
    draw 2drep id 1050 start 624.20s for 2.00s at (108.00, 74.00) x_range = [-1, 5] y_range = [-1, 4] scale = 8.50 grid = true grid_alpha = 0.7 step = 1.0 labels = true color (148, 163, 184, 0.95) width 1.6 ;
    draw 2dfunc id 1051 start 626.80s for 2.60s color (56, 189, 248, 0.95) width 3.2 at 1050 y = 3 - 0.5*(x - 2)^2 ;
    text id 66 start 630.20s for 1.80s at (4.00, 14.50) ''[bold][color=#F8FAFC]Observons la courbe :[/color][/bold]'' ;
    text id 67 start 633.00s for 2.60s at (6.00, 21.00) ''[color=#94A3B8]• Croissante jusqu'en $x = 2$, puis décroissante[/color]'' ;
    draw circle id 1052 start 644.80s color (251, 191, 36, 0.95) width 3.0 radius 1.00 at (125.00, 48.50) ;
    text id 68 start 647.00s for 1.80s at (6.00, 27.50) ''[bold][color=#FBBF24]• Point culminant : Sommet $(2 ; 3)$[/color][/bold]'' ;
    text id 69 start 650.00s for 2.20s at (4.00, 34.00) ''[bold][color=#FBBF24]Le maximum sur cet intervalle :[/color][/bold]'' ;
    draw line id 1053 start 661.00s for 1.50s color (251, 191, 36, 0.95) width 2.0 at [(125.00, 48.50), (108.00, 48.50)] ;
    text id 70 start 663.50s at (6.00, 40.50) ''[bold][color=#FBBF24]• Valeur du maximum : $M = 3$[/color][/bold]'' ;
    text id 71 start 665.50s for 2.50s at (6.00, 47.50) ''[color=#FBBF24](se lit sur l'axe des ordonnées $Oy$)[/color]'' ;
    draw line id 1054 start 670.50s for 1.50s color (52, 211, 153, 0.95) width 2.0 at [(125.00, 48.50), (125.00, 74.00)] ;
    text id 72 start 673.00s at (6.00, 54.00) ''[bold][color=#34D399]• Atteint en : $x = 2$[/color][/bold]'' ;
    text id 73 start 675.50s for 2.50s at (6.00, 61.00) ''[color=#34D399](se lit sur l'axe des abscisses $Ox$)[/color]'' ;
    text id 74 start 689.50s for 1.80s at (4.00, 67.50) ''[bold][color=#38BDF8]Définition formelle :[/color][/bold]'' ;
    text id 75 start 694.00s for 2.60s at (6.00, 74.00) ''[color=#F8FAFC]$M = f(a)$ est le maximum si :[/color]'' ;
    text id 76 start 701.00s for 2.80s at (6.00, 81.00) ''[bold][color=#FBBF24]$$\forall x \in I,\quad f(x) \le M$$[/color][/bold]'' ;
    draw line id 1055 start 709.00s for 1.50s color (251, 191, 36, 0.95) width 1.6 at [(103.75, 48.50), (146.25, 48.50)] ;
    draw circle id 1056 start 715.00s color (52, 211, 153, 0.95) width 2.4 radius 0.75 at (114.80, 54.62) ;
    draw circle id 1057 start 722.00s color (52, 211, 153, 0.95) width 2.4 radius 0.75 at (135.20, 54.62) ;
    text id 77 start 726.00s for 2.60s at (6.00, 92.50) ''[color=#94A3B8]Toute la courbe reste sous la droite $y = 3$.[/color]'' ;
    erase id 4006 start 744.60s ;

    # SCENE 7 : Minimum & Relatif vs Absolu
    text id 78 start 745.00s for 2.20s at (4.00, 5.50) ''[bold][color=#34D399]5. MINIMUM ET EXTREMUM RELATIF VS ABSOLU[/color][/bold]'' ;
    draw line id 1058 start 747.45s color (56, 189, 248, 0.95) width 1.6 at [(4.00, 11.50), (173.00, 11.50)] ;
    draw 2drep id 1059 start 748.20s for 1.80s at (106.00, 60.00) x_range = [-1, 6] y_range = [-3, 4] scale = 7.50 grid = true grid_alpha = 0.7 step = 1.0 labels = true color (148, 163, 184, 0.95) width 1.6 ;
    draw curve id 1060 start 751.00s for 2.60s smooth color (56, 189, 248, 0.95) width 3.2 at [(106.00, 33.75), (109.75, 44.06), (113.50, 52.50), (117.25, 59.06), (121.00, 63.75), (124.75, 66.56), (128.50, 67.50), (132.25, 66.56), (136.00, 63.75)] ;
    text id 79 start 758.00s for 2.20s at (4.00, 14.00) ''[bold][color=#34D399]Minimum sur $I = [0 ; 4]$ :[/color][/bold]'' ;
    draw circle id 1061 start 771.00s color (52, 211, 153, 0.95) width 2.8 radius 0.95 at (128.50, 67.50) ;
    draw line id 1062 start 774.00s for 1.40s color (52, 211, 153, 0.95) width 1.8 at [(128.50, 67.50), (106.00, 67.50)] ;
    text id 80 start 776.50s at (6.00, 21.00) ''[bold][color=#34D399]• Valeur minimale : $m = -1$[/color][/bold]'' ;
    draw line id 1063 start 781.00s for 1.40s color (251, 191, 36, 0.95) width 1.8 at [(128.50, 67.50), (128.50, 60.00)] ;
    text id 81 start 783.50s at (6.00, 28.00) ''[bold][color=#FBBF24]• Atteint en l'abscisse $x = 3$[/color][/bold]'' ;
    text id 82 start 785.50s for 2.50s at (6.00, 35.00) ''[color=#F8FAFC]$\Rightarrow f(x) \ge -1 = f(3)$ sur $[0 ; 4]$[/color]'' ;
    text id 83 start 789.60s for 1.60s at (4.00, 42.00) ''[bold][color=#38BDF8]Définition formelle :[/color][/bold]'' ;
    text id 84 start 793.00s for 2.80s at (6.00, 48.00) ''[bold][color=#34D399]$\forall x \in I,\quad f(x) \ge m = f(b)$[/color][/bold]'' ;
    draw circle id 1064 start 810.00s color (192, 132, 252, 0.95) width 2.2 radius 0.70 at (117.25, 59.06) ;
    draw circle id 1065 start 824.00s color (192, 132, 252, 0.95) width 2.2 radius 0.70 at (132.25, 66.56) ;
    text id 85 start 850.00s for 2.20s at (4.00, 55.00) ''[bold][color=#F87171]Attention à l'intervalle d'étude ![/color][/bold]'' ;
    draw curve id 1066 start 857.50s for 2.50s smooth color (248, 113, 113, 0.95) width 3.2 at [(136.00, 63.75), (140.50, 67.50), (144.25, 72.00), (147.25, 75.00)] ;
    draw circle id 1067 start 876.50s color (248, 113, 113, 0.95) width 2.8 radius 0.90 at (147.25, 75.00) ;
    draw line id 1068 start 880.00s for 1.50s color (248, 113, 113, 0.95) width 1.8 at [(147.25, 75.00), (106.00, 75.00)] ;
    text id 86 start 884.00s at (6.00, 61.50) ''[bold][color=#F87171]• Plus loin : valeur plus basse $-2 < -1$[/color][/bold]'' ;
    text id 87 start 905.50s for 2.80s at (6.00, 68.50) ''[color=#34D399]• Sur $[0 ; 4]$ : $-1$ est minimum ABSOLU[/color]'' ;
    text id 88 start 915.00s for 3.00s at (6.00, 75.50) ''[color=#FBBF24]• Sur $[0 ; 5,5]$ : $-1$ est RELATIF[/color]'' ;
    text id 89 start 922.00s for 2.80s at (6.00, 82.50) ''[color=#94A3B8](localement le plus bas, mais dépassé !)[/color]'' ;
    text id 90 start 934.50s for 2.80s at (4.00, 89.00) ''[color=#38BDF8]Même distinction pour un maximum.[/color]'' ;
    erase id 4007 start 963.70s ;

