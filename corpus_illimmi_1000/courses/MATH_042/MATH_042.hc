course "Fonctions affines et droites du plan" id 42 idgap 500 for 1198.0s audio "narration.wav" {
    text id 1 start 0.15s for 2.00s at (4.0, 7.5) ''[bold][color=#38BDF8]CHAPITRE : ÉQUATIONS DE DROITES DU PLAN[/color][/bold]'' ;
    draw line id 501 start 0.25s for 1.00s color (56, 189, 248, 0.4) width 1.5 at [(4, 13.5), (173, 13.5)] ;
    text id 2 start 37.41s for 2.00s at (4.0, 20.0) ''[bold][color=#FBBF24]1. De la Géométrie au Calcul Algébrique[/color][/bold]'' ;
    text id 3 start 43.00s for 2.00s at (4.0, 32.0) ''[color=#F8FAFC]• Collège : Géométrie euclidienne classique[/color]'' ;
    text id 4 start 49.79s for 2.00s at (6.0, 40.0) ''[color=#94A3B8]Démonstrations textuelles longues (théorèmes, propriétés)[/color]'' ;
    text id 5 start 55.37s for 2.00s at (4.0, 52.0) ''[bold][color=#34D399]• Lycée (Seconde) : Géométrie analytique[/color][/bold]'' ;
    text id 6 start 62.04s for 2.00s at (6.0, 60.0) ''[color=#F8FAFC]Repère cartésien et coordonnées $(x \; ; \; y)$[/color]'' ;
    text id 7 start 68.00s for 2.00s at (4.0, 72.0) ''[bold][color=#38BDF8]Droite $(d) \iff$ Relation algébrique en $x$ et $y$[/color][/bold]'' ;
    text id 8 start 77.44s for 0.70s at (105.0, 22.0) ''[bold][color=#38BDF8]Droites parallèles dans le repère[/color][/bold]'' ;
    draw 2drep id 502 start 78.24s for 1.00s at (133, 56) color (248, 250, 252, 0.95) width 1.5 scale = 6.0 grid = true grid_alpha = 0.7 step = 1 x_range = [-4, 4] y_range = [-4, 4] ;
    draw line id 503 start 79.44s for 1.00s color (56, 189, 248, 0.95) width 2.5 at [(109, 74), (157, 38)] ;
    draw line id 504 start 80.64s for 1.00s color (52, 211, 153, 0.95) width 2.5 at [(115, 80), (157, 48)] ;
    text id 9 start 81.94s for 2.50s at (105.0, 88.0) ''[bold][color=#34D399]Calcul algébrique direct et sans texte lourd[/color][/bold]'' ;
    erase id 2001 start 87.00s ;
    text id 10 start 95.68s for 2.00s at (4.0, 7.5) ''[bold][color=#38BDF8]2. ÉQUATION CARTÉSIENNE & TEST D'APPARTENANCE[/color][/bold]'' ;
    draw line id 511 start 95.78s for 1.00s color (56, 189, 248, 0.4) width 1.5 at [(4, 13.5), (173, 13.5)] ;
    text id 11 start 99.68s for 2.00s at (4.0, 19.0) ''[bold][color=#FBBF24]Forme générale : $\mathbf{ax + by + c = 0}$[/color][/bold]'' ;
    text id 12 start 108.53s for 2.00s at (6.0, 27.0) ''[color=#F8FAFC]$a, b, c \in \mathbb{R}$ fixés (non tous deux nuls)[/color]'' ;
    text id 13 start 115.32s for 2.00s at (4.0, 36.0) ''[bold][color=#38BDF8]Exemple concret : $(d) : 2x + 3y - 1 = 0$[/color][/bold]'' ;
    text id 14 start 129.42s for 2.00s at (6.0, 44.0) ''[color=#94A3B8]Coefficients : $a = 2 \quad ; \quad b = 3 \quad ; \quad c = -1$[/color]'' ;
    text id 15 start 134.96s for 2.00s at (4.0, 53.0) ''[color=#F8FAFC]$M(x \; ; \; y) \in (d) \iff 2x + 3y - 1 = 0$[/color]'' ;
    text id 16 start 142.32s for 2.50s at (103.0, 22.0) ''[bold][color=#38BDF8]Représentation de $(d) : 2x + 3y - 1 = 0$[/color][/bold]'' ;
    draw 2drep id 512 start 143.12s for 1.00s at (133, 56) color (248, 250, 252, 0.95) width 1.5 scale = 6.0 grid = true grid_alpha = 0.7 step = 1 x_range = [-4, 4] y_range = [-4, 4] ;
    draw line id 513 start 144.32s for 1.00s color (56, 189, 248, 0.95) width 2.5 at [(109.0, 38.0), (157.0, 70.0)] ;
    text id 17 start 168.20s for 2.00s at (4.0, 62.0) ''[bold][color=#F87171]• Test du point $A(1 \; ; \; 2)$ :[/color][/bold]'' ;
    text id 18 start 185.34s for 2.00s at (6.0, 70.0) ''[color=#F8FAFC]$2(1) + 3(2) - 1 = 2 + 6 - 1 = 7 \neq 0$[/color]'' ;
    text id 19 start 196.60s for 2.00s at (6.0, 78.0) ''[bold][color=#F87171]$\implies \mathbf{A \notin (d)}$ (Non vérifié)[/color][/bold]'' ;
    draw circle id 514 start 209.13s color (248, 113, 113, 1) fillcolor (248, 113, 113, 0.8) width 1.5 radius 1.4 at (139.0, 44.0) ;
    text id 20 start 214.72s for 2.00s at (4.0, 86.0) ''[bold][color=#34D399]• Test du point $B(-1 \; ; \; 1)$ :[/color][/bold]'' ;
    text id 21 start 231.93s for 2.00s at (6.0, 93.5) ''[color=#F8FAFC]$2(-1) + 3(1) - 1 = -2 + 3 - 1 = 0 \implies \mathbf{B \in (d)}$[/color]'' ;
    draw circle id 515 start 250.36s color (52, 211, 153, 1) fillcolor (52, 211, 153, 0.8) width 1.5 radius 1.4 at (127.0, 50.0) ;
    text id 22 start 251.36s for 3.00s at (101.0, 88.0) ''[bold][color=#F87171]$A(1 ; 2) \notin (d)$[/color][/bold]   [bold][color=#34D399]$B(-1 ; 1) \in (d)$[/color][/bold]'' ;
    erase id 2002 start 277.00s ;
    text id 23 start 278.43s for 2.00s at (4.0, 7.5) ''[bold][color=#38BDF8]3. VECTEUR DIRECTEUR D'UNE DROITE[/color][/bold]'' ;
    draw line id 521 start 278.53s for 1.00s color (56, 189, 248, 0.4) width 1.5 at [(4, 13.5), (173, 13.5)] ;
    text id 24 start 283.54s for 2.00s at (4.0, 19.0) ''[bold][color=#FBBF24]Théorème : Vecteur directeur associé[/color][/bold]'' ;
    text id 25 start 290.68s for 2.00s at (6.0, 28.0) ''[color=#F8FAFC]Toute droite $(d) : ax + by + c = 0$ admet pour vecteur directeur :[/color]'' ;
    text id 26 start 293.18s for 2.00s at (12.0, 38.0) ''[bold][color=#34D399]$\mathbf{\vec{u}(-b \; ; \; a)}$[/color][/bold]'' ;
    text id 27 start 293.56s for 2.00s at (4.0, 48.0) ''[color=#94A3B8]$\vec{u}$ est non nul et caractérise la direction de la droite $(d)$.[/color]'' ;
    text id 28 start 321.76s for 2.00s at (4.0, 58.0) ''[bold][color=#38BDF8]Application à $(d) : 2x + 3y - 1 = 0$ :[/color][/bold]'' ;
    text id 29 start 326.48s for 2.00s at (6.0, 66.0) ''[color=#F8FAFC]$a = 2 \quad \text{et} \quad b = 3 \implies -b = -3 \quad \text{et} \quad a = 2$[/color]'' ;
    text id 30 start 336.16s for 2.00s at (6.0, 76.0) ''[bold][color=#34D399]$\implies \mathbf{\vec{u}(-3 \; ; \; 2)}$ est un vecteur directeur ![/color][/bold]'' ;
    text id 31 start 353.00s for 3.00s at (4.0, 86.0) ''[color=#FBBF24]• Réciproque : $\vec{u}(-b ; a) \implies$ Donne $a$ et $b$ dans $ax + by + c = 0$[/color]'' ;
    text id 32 start 321.86s for 0.70s at (103.0, 22.0) ''[bold][color=#34D399]Direction du vecteur $\vec{u}(-3 \; ; \; 2)$[/color][/bold]'' ;
    draw 2drep id 522 start 322.56s for 0.90s at (133, 56) color (248, 250, 252, 0.95) width 1.5 scale = 6.0 grid = true grid_alpha = 0.7 step = 1 x_range = [-4, 4] y_range = [-4, 4] ;
    draw line id 523 start 323.56s for 1.00s color (56, 189, 248, 0.8) width 2.0 at [(109.0, 38.0), (157.0, 70.0)] ;
    draw arrow id 524 start 341.56s for 1.00s color (52, 211, 153, 1) width 3.0 at [(127.0, 50.0), (109.0, 38.0)] ;
    draw arrow id 525 start 344.06s for 1.00s color (251, 191, 36, 0.9) width 2.5 at [(133.0, 56.0), (115.0, 44.0)] ;
    text id 33 start 345.56s for 3.00s at (108.0, 88.0) ''[bold][color=#34D399]Le vecteur $\vec{u}$ guide la droite $(d)$[/color][/bold]'' ;
    erase id 2003 start 380.00s ;
    text id 34 start 381.92s for 2.00s at (4.0, 7.5) ''[bold][color=#38BDF8]4. DE LA FORME CARTÉSIENNE À L'ÉQUATION RÉDUITE[/color][/bold]'' ;
    draw line id 531 start 382.02s for 1.00s color (56, 189, 248, 0.4) width 1.5 at [(4, 13.5), (173, 13.5)] ;
    text id 35 start 400.80s for 2.00s at (4.0, 19.0) ''[bold][color=#34D399]1er Cas : Isoler $y$ lorsque $b \neq 0$[/color][/bold]'' ;
    text id 36 start 428.98s for 2.00s at (6.0, 27.0) ''[color=#F8FAFC]$2x + 3y - 1 = 0 \iff 3y = -2x + 1$[/color]'' ;
    text id 37 start 436.80s for 2.00s at (6.0, 36.0) ''[bold][color=#38BDF8]$\mathbf{y = -\frac{2}{3}x + \frac{1}{3}}$ (Forme $\mathbf{y = mx + p}$)[/color][/bold]'' ;
    text id 38 start 456.00s for 2.00s at (6.0, 45.0) ''[color=#94A3B8]avec $m = -\frac{2}{3}$ (pente) et $p = \frac{1}{3}$ (ordonnée à l'origine)[/color]'' ;
    text id 39 start 480.44s for 2.00s at (4.0, 54.0) ''[bold][color=#F87171]2e Cas : Aucun terme en $y$ ($b = 0$)[/color][/bold]'' ;
    text id 40 start 489.75s for 2.00s at (6.0, 62.0) ''[color=#F8FAFC]Exemple : $3x - 6 = 0 \iff 3x = 6$[/color]'' ;
    text id 41 start 574.03s for 2.00s at (6.0, 71.0) ''[bold][color=#FBBF24]$\mathbf{x = 2}$ (Équation d'une droite verticale)[/color][/bold]'' ;
    text id 42 start 625.00s for 2.00s at (4.0, 80.0) ''[bold][color=#C084FC]Deux familles de droites dans le plan :[/color][/bold]'' ;
    text id 43 start 630.00s for 3.00s at (6.0, 88.0) ''[color=#F8FAFC]1) Parallèle à $(Oy)$ : $\mathbf{x = c}$   ;   2) Non parallèle : $\mathbf{y = mx + p}$[/color]'' ;
    text id 44 start 595.84s for 0.70s at (105.0, 22.0) ''[bold][color=#FBBF24]Droite verticale $(d) : x = 2$[/color][/bold]'' ;
    draw 2drep id 532 start 596.64s for 0.90s at (133, 56) color (248, 250, 252, 0.95) width 1.5 scale = 6.0 grid = true grid_alpha = 0.7 step = 1 x_range = [-4, 4] y_range = [-4, 4] ;
    draw line id 533 start 597.64s for 1.00s color (251, 191, 36, 1) width 3.0 at [(145.0, 32.0), (145.0, 80.0)] ;
    draw circle id 534 start 598.84s color (52, 211, 153, 1) fillcolor (52, 211, 153, 0.8) width 1.5 radius 1.2 at (145.0, 56.0) ;
    draw circle id 535 start 599.64s color (52, 211, 153, 1) fillcolor (52, 211, 153, 0.8) width 1.5 radius 1.2 at (145.0, 44.0) ;
    draw circle id 536 start 600.44s color (52, 211, 153, 1) fillcolor (52, 211, 153, 0.8) width 1.5 radius 1.2 at (145.0, 68.0) ;
    text id 45 start 601.34s for 3.00s at (103.0, 88.0) ''[bold][color=#FBBF24]Tous les points ont pour abscisse $x = 2$[/color][/bold]'' ;
    erase id 2004 start 656.00s ;
    text id 46 start 657.60s for 2.00s at (4.0, 7.5) ''[bold][color=#38BDF8]5. INTERPRÉTATION GRAPHIQUE : PENTE $m$ ET ORDONNÉE $p$[/color][/bold]'' ;
    draw line id 541 start 657.70s for 1.00s color (56, 189, 248, 0.4) width 1.5 at [(4, 13.5), (173, 13.5)] ;
    text id 47 start 671.08s for 2.00s at (4.0, 19.0) ''[bold][color=#34D399]• Le coefficient directeur $m$ (Pente) :[/color][/bold]'' ;
    text id 48 start 676.77s for 2.00s at (6.0, 27.0) ''[color=#F8FAFC]Avancer de $+1$ en abscisse $\implies$ Monter/descendre de $m$ en ordonnée[/color]'' ;
    text id 49 start 698.24s for 2.00s at (4.0, 38.0) ''[bold][color=#38BDF8]• L'ordonnée à l'origine $p$ :[/color][/bold]'' ;
    text id 50 start 705.00s for 2.00s at (6.0, 46.0) ''[color=#F8FAFC]Valeur de $y$ pour $x = 0 \implies$ Coupe l'axe $(Oy)$ en $(0 \; ; \; p)$[/color]'' ;
    text id 51 start 720.56s for 0.10s at (4.0, 58.0) ''[bold][color=#FBBF24]Exemple concret : $(d) : y = 3x + 2$[/color][/bold]'' ;
    draw line id 543 start 722.56s for 1.00s color (56, 189, 248, 0.95) width 2.5 at [(125.0, 77.0), (137.0, 32.0)] ;
    draw 2drep id 542 start 721.36s for 1.00s at (133, 62) color (248, 250, 252, 0.95) width 1.5 scale = 5.2 grid = true grid_alpha = 0.7 step = 1 x_range = [-3, 3] y_range = [-3, 5] ;
    text id 55 start 720.66s for 2.50s at (103.0, 22.0) ''[bold][color=#38BDF8]Tracé de $(d) : y = 3x + 2$ et escalier[/color][/bold]'' ;
    text id 52 start 734.16s for 0.10s at (6.0, 67.0) ''[color=#38BDF8]$p = 2 \implies$ Point d'ancrage $P_0(0 \; ; \; 2)$ sur l'axe vertical[/color]'' ;
    draw circle id 544 start 734.26s color (56, 189, 248, 1) fillcolor (56, 189, 248, 0.8) width 1.5 radius 1.3 at (133.0, 51.6) ;
    text id 53 start 743.56s for 0.10s at (6.0, 76.0) ''[color=#34D399]$m = 3 \implies \Delta x = +1 \rightarrow \Delta y = +3 \implies P_1(1 \; ; \; 5)$[/color]'' ;
    draw line id 545 start 743.66s color (251, 191, 36, 1) width 2.5 at [(133.0, 51.6), (138.2, 51.6)] ;
    draw line id 546 start 745.36s color (52, 211, 153, 1) width 2.5 at [(138.2, 51.6), (138.2, 36.0)] ;
    draw circle id 547 start 746.76s color (52, 211, 153, 1) fillcolor (52, 211, 153, 0.8) width 1.5 radius 1.3 at (138.2, 36.0) ;
    text id 56 start 748.06s for 3.00s at (101.0, 88.0) ''[bold][color=#38BDF8]Ordonnée à l'origine $p = 2$[/color][/bold]   [bold][color=#34D399]Pente $m = 3$[/color][/bold]'' ;
    text id 54 start 774.78s for 3.00s at (4.0, 87.0) ''[color=#C084FC]Droite verticale : $x = 3 \implies$ Parallèle à $(Oy)$[/color]'' ;
    erase id 2005 start 784.00s ;
    text id 57 start 785.68s for 2.00s at (4.0, 7.5) ''[bold][color=#38BDF8]6. CALCUL DU COEFFICIENT DIRECTEUR PAR DEUX POINTS[/color][/bold]'' ;
    draw line id 551 start 785.78s for 1.00s color (56, 189, 248, 0.4) width 1.5 at [(4, 13.5), (173, 13.5)] ;
    text id 58 start 808.24s for 2.00s at (4.0, 19.0) ''[bold][color=#FBBF24]Formule du taux de variation :[/color][/bold]'' ;
    text id 59 start 810.74s for 2.00s at (10.0, 29.0) ''[bold][color=#34D399]$\mathbf{m = \frac{y_B - y_A}{x_B - x_A}}$[/color][/bold]'' ;
    text id 60 start 836.32s for 2.00s at (4.0, 40.0) ''[color=#F8FAFC]Condition impérative : $\mathbf{x_A \neq x_B}$[/color]'' ;
    text id 61 start 849.46s for 2.00s at (4.0, 49.0) ''[bold][color=#F87171]• Piège classique si $x_A = x_B$ :[/color][/bold]'' ;
    text id 62 start 860.00s for 2.00s at (6.0, 57.0) ''[color=#94A3B8]Dénominateur nul $\implies$ Droite verticale $(AB) : x = x_A$ (pas de pente $m$)[/color]'' ;
    text id 63 start 896.48s for 0.10s at (4.0, 68.0) ''[bold][color=#38BDF8]• Exemple d'application : $A(1 \; ; \; 2)$ et $B(3 \; ; \; 4)$[/color][/bold]'' ;
    draw 2drep id 552 start 897.28s for 1.00s at (120, 68) color (248, 250, 252, 0.95) width 1.5 scale = 6.0 grid = true grid_alpha = 0.7 step = 1 x_range = [-1, 5] y_range = [-1, 5] ;
    draw line id 553 start 898.48s for 1.00s color (56, 189, 248, 0.95) width 2.5 at [(116.0, 66.0), (148.0, 34.0)] ;
    text id 66 start 896.58s for 2.50s at (103.0, 22.0) ''[bold][color=#38BDF8]Droite $(AB)$ et triangle de variation[/color][/bold]'' ;
    text id 64 start 924.70s for 0.10s at (6.0, 77.0) ''[color=#F8FAFC]$m = \frac{4 - 2}{3 - 1} = \frac{2}{2} = \mathbf{1}$[/color]'' ;
    draw circle id 554 start 924.80s color (56, 189, 248, 1) fillcolor (56, 189, 248, 0.8) width 1.5 radius 1.3 at (126.0, 56.0) ;
    draw circle id 555 start 926.70s color (52, 211, 153, 1) fillcolor (52, 211, 153, 0.8) width 1.5 radius 1.3 at (138.0, 44.0) ;
    text id 65 start 938.72s for 0.10s at (6.0, 87.0) ''[bold][color=#34D399]La droite $(AB)$ a pour coefficient directeur $\mathbf{m = 1}$[/color][/bold]'' ;
    draw line id 556 start 938.82s color (251, 191, 36, 1) width 2.0 at [(126.0, 56.0), (138.0, 56.0)] ;
    draw line id 557 start 940.52s color (52, 211, 153, 1) width 2.0 at [(138.0, 56.0), (138.0, 44.0)] ;
    text id 67 start 941.72s for 3.00s at (101.0, 88.0) ''[bold][color=#FBBF24]$\Delta x = 3 - 1 = 2$[/color][/bold]   [bold][color=#34D399]$\Delta y = 4 - 2 = 2$[/color][/bold]'' ;
    erase id 2006 start 950.00s ;
    text id 68 start 952.56s for 2.00s at (4.0, 7.5) ''[bold][color=#38BDF8]7. POSITION RELATIVE DE DEUX DROITES & SYNTHÈSE[/color][/bold]'' ;
    draw line id 561 start 952.66s for 1.00s color (56, 189, 248, 0.4) width 1.5 at [(4, 13.5), (173, 13.5)] ;
    text id 69 start 970.80s for 2.00s at (4.0, 18.0) ''[bold][color=#FBBF24]1. Avec les équations cartésiennes :[/color][/bold]'' ;
    text id 70 start 974.79s for 2.00s at (6.0, 25.5) ''[color=#F8FAFC]$(d) \parallel (d') \iff \vec{u}(-b ; a)$ et $\vec{u'}(-b' ; a')$ colinéaires[/color]'' ;
    text id 71 start 992.63s for 2.00s at (6.0, 33.5) ''[color=#94A3B8]Critère : $(-b)(a') - (a)(-b') = -ba' + ab' = 0$[/color]'' ;
    text id 72 start 1011.92s for 2.00s at (4.0, 43.0) ''[bold][color=#38BDF8]2. Avec les équations réduites :[/color][/bold]'' ;
    text id 73 start 1046.64s for 2.00s at (6.0, 50.0) ''[color=#F8FAFC]• $(d_1) : y = 3x + 4$ et $(d_2) : y = 3x + 9$[/color]'' ;
    text id 74 start 1072.80s for 2.00s at (10.0, 56.5) ''[bold][color=#34D399]$\implies m = m' = 3 \implies (d_1) \parallel (d_2)$[/color][/bold]'' ;
    text id 75 start 1084.00s for 2.00s at (6.0, 64.0) ''[color=#F8FAFC]• $(d_3) : x = 8$ et $(d_4) : x = -1 \implies \mathbf{(d_3) \parallel (d_4)}$[/color]'' ;
    text id 76 start 1124.19s for 2.00s at (6.0, 71.5) ''[color=#F8FAFC]• $(d_1)$ inclinée et $(d_3)$ verticale $\implies \mathbf{Sécantes}$[/color]'' ;
    text id 77 start 1185.99s for 2.00s at (6.0, 79.0) ''[color=#F8FAFC]• $(d_5) : y = -2x + 1$ et $(d_1) \implies \mathbf{Sécantes}$[/color]'' ;
    draw polygone id 562 start 1134.32s color (56, 189, 248, 0.8) fillcolor (15, 23, 42, 0.25) width 2.0 at [(104, 18), (174, 18), (174, 92), (104, 92), (104, 18)] ;
    text id 78 start 1135.32s for 0.50s at (112.0, 22.0) ''[bold][color=#FBBF24]TABLEAU DE SYNTHÈSE[/color][/bold]'' ;
    draw line id 563 start 1135.82s for 1.00s color (56, 189, 248, 0.4) width 1.0 at [(106, 27), (172, 27)] ;
    text id 79 start 1137.32s for 1.50s at (106.0, 32.0) ''[bold][color=#38BDF8]Situation 1 :[/color][/bold]'' ;
    text id 80 start 1138.82s for 1.50s at (108.0, 39.0) ''[color=#F8FAFC]$x = n$ et $x = n'$[/color]'' ;
    text id 81 start 1140.32s for 0.70s at (139.0, 39.0) ''[bold][color=#34D399]$\implies$ PARALLÈLES[/color][/bold]'' ;
    draw line id 564 start 1141.32s for 1.00s color (255, 255, 255, 0.15) width 1.0 at [(106, 47), (172, 47)] ;
    text id 82 start 1142.82s for 1.50s at (106.0, 52.0) ''[bold][color=#38BDF8]Situation 2 :[/color][/bold]'' ;
    text id 83 start 1144.32s for 1.50s at (108.0, 59.0) ''[color=#F8FAFC]$y = mx + p$ et $x = n$[/color]'' ;
    text id 84 start 1145.82s for 0.70s at (141.0, 59.0) ''[bold][color=#F87171]$\implies$ SÉCANTES[/color][/bold]'' ;
    draw line id 565 start 1146.82s for 1.00s color (255, 255, 255, 0.15) width 1.0 at [(106, 67), (172, 67)] ;
    text id 85 start 1148.32s for 2.00s at (106.0, 72.0) ''[bold][color=#38BDF8]Situation 3 :[/color][/bold] $y = mx+p$ et $y = m'x+p'$'' ;
    text id 86 start 1150.32s for 2.00s at (108.0, 79.0) ''[color=#34D399]• Si $\mathbf{m = m'}$[/color] $\implies$ [bold][color=#34D399]PARALLÈLES[/color][/bold]'' ;
    text id 87 start 1152.32s for 2.00s at (108.0, 86.0) ''[color=#F87171]• Si $\mathbf{m \neq m'}$[/color] $\implies$ [bold][color=#F87171]SÉCANTES[/color][/bold]'' ;
}